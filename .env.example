# VietPDF Environment Variables
# Copy this file to .env.production and configure as needed.
# These values are baked into the build at build time.

# =============================================================================
# CORS PROXY (Digital Signature Tool)
# =============================================================================
# Deploy the worker from cloudflare/ first, then paste its URL here.
# Example: https://vietpdf-cors-proxy.YOUR_ACCOUNT.workers.dev
VITE_CORS_PROXY_URL=
# Optional HMAC secret (deterrent against casual abuse):
VITE_CORS_PROXY_SECRET=

# =============================================================================
# WASM MODULE URLs
# =============================================================================
# Pre-configured defaults enable advanced PDF features out of the box.
# For air-gapped / offline deployments, point these to your internal server.
VITE_WASM_PYMUPDF_URL=https://cdn.jsdelivr.net/npm/@bentopdf/pymupdf-wasm@0.11.16/
VITE_WASM_GS_URL=https://cdn.jsdelivr.net/npm/@bentopdf/gs-wasm@0.1.1/assets/
VITE_WASM_CPDF_URL=https://cdn.jsdelivr.net/npm/coherentpdf@2.5.5/dist/

# =============================================================================
# LIBREOFFICE WASM CDN (Required for Cloudflare Pages)
# =============================================================================
# Cloudflare Pages has a 25 MB per-file limit. The LibreOffice WASM files
# (~27 MB + ~46 MB) must be hosted externally. Upload them to R2/S3 and set
# the public URL here. The small .js files are still served from /libreoffice-wasm/.
# Example: https://r2.vietpdf.com/libreoffice-wasm/
VITE_LIBREOFFICE_CDN_URL=https://vietpdf-r2-assets.misao.workers.dev/libreoffice-wasm/

# =============================================================================
# OCR ASSETS (Optional)
# =============================================================================
# Set all three together for self-hosted or air-gapped OCR.
# Leave empty to use Tesseract.js runtime defaults.
VITE_TESSERACT_WORKER_URL=
VITE_TESSERACT_CORE_URL=
VITE_TESSERACT_LANG_URL=
VITE_TESSERACT_AVAILABLE_LANGUAGES=
VITE_OCR_FONT_BASE_URL=

# =============================================================================
# BRANDING (Build-time)
# =============================================================================
VITE_BRAND_NAME=VietPDF
VITE_BRAND_LOGO=images/favicon-no-bg.svg
VITE_FOOTER_TEXT=© 2026 VietPDF. All rights reserved.

# =============================================================================
# CLOUDFLARE R2 CREDENTIALS (For uploading large WASM assets)
# =============================================================================
# Only needed to run `npm run upload:r2`. Get keys from:
# Cloudflare Dashboard → R2 → Manage R2 API Tokens
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=vietpdf-assets
R2_PUBLIC_URL=

# =============================================================================
# DEFAULT LANGUAGE (Build-time)
# =============================================================================
# Supported: en, ar, be, fr, de, es, zh, zh-TW, vi, tr, id, it, pt, nl, da, ko, sv, ru
VITE_DEFAULT_LANGUAGE=en
